# Notion Integration — get your token at notion.so/profile/integrations
# 1. Click "+ New connection" → Internal → name it "Beautiful Journal" → click Create
# 2. Copy the "Internal Integration Secret" token below
# 3. In Notion, open "Journal: Private Property." → Share → Connect to → Beautiful Journal
NOTION_TOKEN=ntn_your_token_here

# Your journal database ID (already pre-filled — this is your "Journal: Private Property." DB)
NOTION_DATABASE_ID=98c7568de9d44973b0f5d246f22dabec
